{
  "name": "hecatron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "compile:cql": "node scripts/compile-cql.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run compile:cql && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run compile:cql && node --test src/domain.test.ts",
    "test:browser": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:doctor": "powershell -NoProfile -File poc\\scripts\\android.ps1 -ProjectRoot . -Doctor",
    "android:build": "powershell -NoProfile -File poc\\scripts\\android.ps1 -ProjectRoot ."
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "cql-execution": "3.3.2",
    "idb": "8.0.4",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@cqframework/cql": "5.6.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
