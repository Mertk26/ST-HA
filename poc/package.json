{
  "name": "hecatron-concept-proofs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "compile:cql": "node scripts/compile-cql.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run compile:cql && npm run typecheck && vite build",
    "dev": "vite --host 127.0.0.1",
    "test": "npm run compile:cql && node --test src/engine.test.ts src/notifications.test.ts scripts/compile-cql.test.mjs",
    "test:browser": "playwright test",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:doctor": "powershell -NoProfile -File scripts\\android.ps1 -Doctor",
    "android:build": "powershell -NoProfile -File scripts\\android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "cql-execution": "3.3.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@cqframework/cql": "5.6.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
